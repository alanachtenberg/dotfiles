# ==============================================================================
# Shell Environment, Navigation & Dotfiles
# ==============================================================================
brew "atuin"                   # SQLite-backed contextual shell history (Ctrl+R)
brew "fzf"                     # General command-line fuzzy finder
brew "mise"                    # Polyglot runtime manager (Node, Python, Java, Go, etc.)
brew "starship"                # Cross-shell prompt
brew "stow"                    # Symlink farm manager for dotfiles
brew "zoxide"                  # Smarter cd command based on frecency
brew "zsh-autosuggestions"     # Fish-like autosuggestions for Zsh
brew "zsh-syntax-highlighting" # Fish-like syntax highlighting for Zsh

# ==============================================================================
# Modern CLI Replacements & File Utilities
# ==============================================================================
brew "bat"                     # Cat replacement with syntax highlighting
brew "dust"                    # Intuitive disk usage (du) replacement
brew "eza"                     # Modern ls replacement with git status & tree view
brew "fd"                      # Fast, user-friendly find alternative
brew "jq"                      # Lightweight command-line JSON processor
brew "ripgrep"                 # Extremely fast recursive regex search (grep)
brew "tldr"                    # Simplified, practical alternative to man pages

# ==============================================================================
# Git & Version Control
# ==============================================================================
brew "gh"                      # Official GitHub CLI
brew "git-delta"               # Syntax-highlighting pager for git and diffs
brew "lazygit"                 # Terminal UI for git operations

# ==============================================================================
# Editor, Workspace & Monitoring
# ==============================================================================
brew "btop"                    # Resource and process monitor (CPU, RAM, GPU, disks)
brew "herdr"                   # Agent multiplexer that lives in your terminal
brew "lazydocker"              # Terminal UI for Docker containers and images
brew "micro"                   # Modern, intuitive terminal text editor (Git editor)
brew "neovim"                  # Extensible modal text editor

